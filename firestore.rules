rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /project_requests/{requestId} {
      // PII must never be readable by clients. Dashboards read via the Admin SDK.
      allow read: if false;

      // New submissions always start as "incomplete" and must validate that
      // 'to' matches exactly with 'userEmail'.
      allow create: if request.resource.data.status == 'incomplete'
                    && request.resource.data.to == request.resource.data.userEmail;

      // A request can only be modified while still in progress. Once it is
      // "complete" it becomes immutable. Updates must maintain the email matching rule.
      allow update: if resource.data.status != 'complete'
                    && request.resource.data.to == request.resource.data.userEmail;
    }

    match /subscriptions/{subId} {
      allow create: if true;
    }
  }
}
