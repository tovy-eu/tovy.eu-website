rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /project_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /subscriptions/{subId} {
      allow create: if true;
    }
  }
}
