
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default to a secure "deny all" rule
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Allow anyone to submit a project request.
     * @path /project_requests/{requestId}
     * @principle Unauthenticated users need to be able to create requests.
     *            No one should be able to read or modify other requests.
     */
    match /project_requests/{requestId} {
      allow create: if true;
    }

    /**
     * @description Allow anyone to subscribe to the newsletter.
     * @path /subscriptions/{subId}
     * @principle Unauthenticated users can add their email.
     *            Privacy: Reading existing subscriptions is strictly forbidden.
     */
    match /subscriptions/{subId} {
      allow create: if true;
      // Note: SubscriptionForm uses a query to check for duplicates. 
      // To support this securely without allowing full reads, consider 
      // using the email as the document ID and check 'exists()'.
    }
  }
}
