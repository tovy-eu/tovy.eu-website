
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default to a secure "deny all" rule
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Allow anyone to submit a project request.
     * @path /project_requests/{requestId}
     * @principle Unauthenticated users need to be able to create requests.
     *            No one should be able to read or modify other requests.
     */
    match /project_requests/{requestId} {
      allow create: if true;
    }
    
    /**
     * @description Allow anyone to subscribe to the newsletter.
     * @path /subscriptions/{subscriptionId}
     * @principle Unauthenticated users need to be able to subscribe.
     *            The client needs to query for existing emails to prevent duplicates.
     *            No one should be able to read the full subscriber list.
     */
    match /subscriptions/{subscriptionId} {
      allow read, create: if true;
    }
  }
}
