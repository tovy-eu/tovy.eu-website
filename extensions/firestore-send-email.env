# The Cloud Region to deploy the extension's Cloud Functions
LOCATION=europe-west4

# The monitored Firestore collection for triggering emails
MAIL_COLLECTION=project_requests

# The region where the Cloud Firestore database instance resides
DATABASE_REGION=europe-west4

# SMTP Connection details. Passwords are reference-linked to Secret Manager.
SMTP_CONNECTION_URI=smtps://lettermint@smtp.lettermint.co:465
SMTP_PASSWORD=projects/${param:PROJECT_ID}/secrets/SMTP_PASSWORD/versions/latest

# Default "From" details if not specified on individual documents
DEFAULT_FROM=noreply@tovy.eu
DEFAULT_REPLY_TO=info@tovy.eu
